            "name": "com:require_sneak",
            "default": true
        },
        {
            "type": "dropdown",
            "text": "§fHunger exhaustion mode",
            "name": "com:hunger_mode",
            "options": [
                {
                    "name": "none",
                    "text": "None§7 no exhaustion will be applied"
                },
                {
                    "name": "vanilla",
                    "text": "Vanilla§7 vanilla exhaustion"
                },
                {
                    "name": "exhaustion",
                    "text": "Exhaustion§7 weighted exhaustion §q(Recommended)"
